apiVersion: dapr.io/v2alpha1
kind: Subscription
metadata:
  name: user-order-completed
spec:
  pubsubname: pubsub
  topic: order.completed
  routes:
    default: /api/events/order-completed
  scopes:
  - user-service
---
apiVersion: dapr.io/v2alpha1
kind: Subscription
metadata:
  name: user-customer-updated
spec:
  pubsubname: pubsub
  topic: customer.updated
  routes:
    default: /api/events/customer-updated
  scopes:
  - user-service
