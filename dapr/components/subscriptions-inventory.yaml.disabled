apiVersion: dapr.io/v2alpha1
kind: Subscription
metadata:
  name: inventory-order-created
spec:
  pubsubname: pubsub
  topic: order.created
  routes:
    default: /api/events/order-created
  scopes:
  - inventory-service
---
apiVersion: dapr.io/v2alpha1
kind: Subscription
metadata:
  name: inventory-order-completed
spec:
  pubsubname: pubsub
  topic: order.completed
  routes:
    default: /api/events/order-completed
  scopes:
  - inventory-service
---
apiVersion: dapr.io/v2alpha1
kind: Subscription
metadata:
  name: inventory-order-failed
spec:
  pubsubname: pubsub
  topic: order.failed
  routes:
    default: /api/events/order-failed
  scopes:
  - inventory-service
